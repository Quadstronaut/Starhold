---
/**
 * Header override: a re-implementation of Starlight 0.41's components/Header.astro
 * (STAR-27 spec §2.2). Kept from the original: the three-column grid that lines
 * the search box up with the content column, and the `shouldRenderSearch` rule.
 * Changed: the right group (social icons, theme and language pickers) is
 * replaced by the fleet cluster. ThemeSelect and LanguageSelect are gone for
 * good (dark only, one locale), and there are no social icons.
 */
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import FleetHeader from './FleetHeader.astro';

/** Render Search if Pagefind is on or the default Search has been overridden (as upstream). */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden search-wrapper">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-flex print:hidden right-group">
		<FleetHeader />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Long titles must never cover the search and menu buttons. */
			overflow: clip;
			/* Room for the focus ring around the title link. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
			gap: var(--sp-3);
		}

		.right-group {
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					/* 1 (site title): up to the main column's left edge, or the title's width if wider */
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					/* 2 (search): all the free space */
					1fr
					/* 3 (fleet cluster): what it needs */
					auto;
				align-content: center;
			}
		}
	}
</style>
