		<path d="M278 84 L372 84 M318 206 L372 206 M318 266 L372 266 M264 370 L372 370 M264 402 L372 402" stroke-dasharray="2 5"/>
		<path d="M112 100 L152 70.9 L232 70.9 L272 100 M152 54.9 L152 70.9 M232 54.9 L232 70.9 M72 266 L132 222.4 L252 222.4 L312 266 M132 162.4 L132 222.4 M252 162.4 L252 222.4 M126 402 L159 378 L225 378 L258 402 M159 346 L159 378 M225 346 L225 378" stroke-dasharray="4 4"/>
		<path d="M192 150 L186 140 M192 150 L198 140 M192 336 L186 326 M192 336 L198 326"/>
	</g>
	<g class="drift">
		<!-- part 1: cap plate, mast, dish -->
		<path class="quiet near" d="M272 84 L232 113.1 L152 113.1 L112 84 L152 54.9 L232 54.9 Z M272 84 L272 100 M232 113.1 L232 129.1 M152 113.1 L152 129.1 M112 84 L112 100 M272 100 L232 129.1 L152 129.1 L112 100"/>
		<path class="quiet" d="M192 84 L192 30 M168 40 Q192 62 216 40"/>
