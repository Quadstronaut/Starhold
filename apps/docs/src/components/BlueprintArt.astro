---
/**
 * Blueprint, the starhold.fyi hero motif (STAR-27 spec §1.3): an exploded
 * drawing of the storefront's station. The hub is the storefront HeroArt core
 * path, byte for byte, so the family link is deliberate; the masts and solar
 * wings are pulled off it along dashed leaders, with numbered callouts, one
 * dimension line and a drawing-sheet frame. No stars: those belong to the
 * hangar.
 *
 * Colour is never a literal: every stroke and fill is currentColor, and the
 * fleet-base .fleet-art classes point it at tokens (.lane faint guides, .quiet
 * structure, .lit the one accent line, .lights the signal points). Motion is
 * CSS only and finite: the assembly drifts twice over 28 s and rests.
 * Decorative, so hidden from assistive tech; the SVG text is drawing
 * annotation, not content.
 */

// Drawing-sheet ticks along the frame, every 24 viewBox units.
const ticks = Array.from({ length: 19 }, (_, i) => 24 + i * 24);
---

<svg
	class="fleet-art fyi-art"
	viewBox="0 0 480 480"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	<!-- sheet frame, edge ticks and title block: static, the paper itself -->
	<g class="lane">
		<rect x="8" y="8" width="464" height="464" rx="2" />
		<path d={ticks.map((t) => `M${t} 8 L${t} ${t % 96 === 0 ? 18 : 13} M8 ${t} L${t % 96 === 0 ? 18 : 13} ${t}`).join(' ')} />
		<path d="M344 436 L472 436 M344 436 L344 472 M344 454 L472 454" />
	</g>
	<g class="quiet fyi-art-text" fill="currentColor" stroke="none">
		<text x="352" y="449">CORE ASSEMBLY</text>
		<text x="352" y="467">DETAIL A · 1:4</text>
	</g>

	<!-- the exploded assembly drifts as one body -->
	<g class="drift">
		<!-- assembly ghost: where the docking ring sits once it is all put together -->
		<ellipse class="lane" cx="240" cy="240" rx="82" ry="24" transform="rotate(-18 240 240)" stroke-dasharray="2 6" />

		<!-- leaders: each part's path back to the hub -->
		<path class="lane" d="M240 196 L240 156 M240 284 L240 314 M194 240 L156 233 M286 240 L324 233" stroke-dasharray="3 6" />

		<!-- the hub: the storefront core, exactly, with its inner face and hatching -->
		<path class="lit" d="M286 240 L263 279.8 L217 279.8 L194 240 L217 200.2 L263 200.2 Z" />
		<path class="quiet" d="M274 240 L257 269.4 L223 269.4 L206 240 L223 210.6 L257 210.6 Z" />
		<path class="quiet" d="M214 232 L232 214 M222 246 L248 220 M232 262 L262 232 M248 266 L268 246" opacity="0.55" />

		<!-- upper mast and dish, lifted off -->
		<path class="quiet" d="M240 150 L240 112 M240 112 L224 100 M240 112 L256 100 M224 100 Q240 86 256 100" />
		<!-- lower mast, dropped -->
		<path class="quiet" d="M240 318 L240 358 M228 358 L252 358" />

		<!-- solar wings, pulled outboard with their spar stubs -->
		<g class="quiet">
			<path d="M24 214 L152 196 L152 270 L24 288 Z" />
			<path d="M56 210 L56 284 M88 205 L88 279 M120 200 L120 274" />
			<path d="M28 251 L152 233" />
			<path d="M328 196 L456 214 L456 288 L328 270 Z" />
			<path d="M360 200 L360 274 M392 205 L392 279 M424 210 L424 284" />
			<path d="M328 233 L452 251" />
		</g>

		<!-- callouts: balloon, leader, part -->
		<g class="lane">
			<path d="M88 159 L88 204 M296 96 L258 101 M318 324 L266 283 M392 159 L392 204" />
			<circle cx="88" cy="150" r="9" />
			<circle cx="305" cy="94" r="9" />
			<circle cx="325" cy="330" r="9" />
			<circle cx="392" cy="150" r="9" />
		</g>
		<g class="quiet fyi-art-text" fill="currentColor" stroke="none" text-anchor="middle">
			<text x="88" y="154">1</text>
			<text x="305" y="98">2</text>
			<text x="325" y="334">3</text>
			<text x="392" y="154">4</text>
		</g>

		<!-- one dimension: across the hub's flats -->
		<g class="lane">
			<path d="M194 288 L194 404 M286 288 L286 404" stroke-dasharray="2 5" />
			<path d="M194 396 L286 396 M194 396 L202 392 M194 396 L202 400 M286 396 L278 392 M286 396 L278 400" />
		</g>
		<text class="quiet fyi-art-text" x="240" y="388" text-anchor="middle" fill="currentColor" stroke="none">92</text>

		<!-- signal points ride with the parts: hub, wing tips, dish, lower mast -->
		<g class="lights" fill="currentColor" stroke="none">
			<circle cx="240" cy="240" r="5" />
			<circle cx="24" cy="214" r="3" />
			<circle cx="456" cy="288" r="3" />
			<circle cx="240" cy="93" r="2.5" />
			<circle cx="240" cy="358" r="2.5" />
		</g>
	</g>
</svg>
