		<path d="M344 436 L472 436 M344 436 L344 472 M344 454 L472 454"/>
	</g>
	<g class="quiet fyi-art-text" fill="currentColor" stroke="none"><text x="352" y="449">CORE ASSEMBLY</text><text x="352" y="467">DETAIL A · 1:4</text></g>
	<!-- far: assembly axis (chain line), projection lines to the elevation, hidden edges -->
	<g class="far">
