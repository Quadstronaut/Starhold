---
/**
 * One tile on the docs splash shelf: the storefront capability tile, as an
 * <article> with a stretched heading link, so the whole tile is clickable while
 * the link's accessible name stays the title alone. External destinations get
 * a ↗ instead of → so leaving the site is never a surprise.
 *
 * Icons are 24 px line drawings on currentColor (the .chip-lg rule sets stroke
 * width and colour from tokens).
 */
interface Props {
	title: string;
	href: string;
	icon: 'bots' | 'shush' | 'qnix' | 'code' | 'log' | 'store' | 'apps' | 'status';
}
const { title, href, icon } = Astro.props;
const external = /^https?:\/\//.test(href);

const paths: Record<Props['icon'], string> = {
	// chat bubble with two command dots
	bots: 'M4 5h16v11H9l-5 4z M9 10.5h.01 M15 10.5h.01',
	// speech bubble, struck through: the quiet game
	shush: 'M4 5h16v11H9l-5 4z M5 4l15 15',
	// stacked hex layers
	qnix: 'M12 3l8 4.5-8 4.5-8-4.5z M4 12l8 4.5 8-4.5 M4 16.5L12 21l8-4.5',
	// braces
	code: 'M9 4c-2 0-3 1-3 3v2c0 1.5-1 3-2 3 1 0 2 1.5 2 3v2c0 2 1 3 3 3 M15 4c2 0 3 1 3 3v2c0 1.5 1 3 2 3-1 0-2 1.5-2 3v2c0 2-1 3-3 3',
	// dated entries
	log: 'M5 4h14v16H5z M8 8h8 M8 12h8 M8 16h5',
	// shop bag
	store: 'M5 8h14l-1 12H6z M9 8V6a3 3 0 0 1 6 0v2',
	// a 2x2 of app squares
	apps: 'M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z',
	// pulse line
	status: 'M3 12h4l2-5 4 10 2-5h6'
};
---

<article class="tile reveal fyi-shelf">
	<span class="chip-lg"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={paths[icon]}></path></svg></span>
	<h3><a class="stretched" href={href} rel={external ? 'noopener' : undefined}>{title}</a></h3>
	<p><slot /></p>
	<span class="go" aria-hidden="true">{external ? '↗' : '→'}</span>
</article>
