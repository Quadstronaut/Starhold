{
	"name": "storefront",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"stats": "node scripts/gen-stats.mjs",
		"contact:purge": "tsx scripts/contact-purge.ts",
		"contact:export": "tsx scripts/contact-export.ts",
		"contact:close": "tsx scripts/contact-close.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.2",
		"vite": "^8.3.6",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"age-encryption": "^0.3.1",
		"better-sqlite3": "^13.0.3",
		"tsx": "^4.23.15"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
