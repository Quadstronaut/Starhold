# Starhold Peridot relay image (PERI-14): strfry built from its pinned source tag, plus the write policy and config.
# There is no official strfry registry image, so it is built here, the way other fleet images are built:
#   podman build --build-arg REVISION=<sha> -t localhost/peridot-relay:candidate apps/peridot-relay
# Pins: strfry tag 1.1.3 must resolve to the commit below or the build stops; the base is digest-pinned (bump the
# tag AND the digest together). The submodules (golpe, negentropy) are pinned by the strfry commit itself.
ARG ALPINE=docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

FROM ${ALPINE} AS build
ARG STRFRY_TAG=1.1.3
ARG STRFRY_COMMIT=16c00df04e264f4d68db5e10a48127f015c7824b
RUN apk add --no-cache git g++ make perl linux-headers pkgconf libtool ca-certificates \
      openssl-dev zlib-dev lmdb-dev flatbuffers-dev libsecp256k1-dev zstd-dev
RUN git clone --quiet --branch "$STRFRY_TAG" https://github.com/hoytech/strfry.git /build \
 && cd /build \
 && test "$(git rev-parse HEAD)" = "$STRFRY_COMMIT" \
 && git submodule update --init \
 && make setup-golpe \
 && make -j4

FROM ${ALPINE}
# python3 runs the write policy; the rest are strfry's shared libraries.
RUN apk add --no-cache lmdb flatbuffers libsecp256k1 libb2 zstd-libs openssl python3 \
 && addgroup -S -g 10044 strfry \
 && adduser -S -D -H -h /var/lib/strfry -s /sbin/nologin -u 10044 -G strfry strfry \
 && install -d -m 0700 -o 10044 -g 10044 /var/lib/strfry
COPY --from=build /build/strfry /app/strfry
COPY strfry.conf /etc/strfry.conf
COPY --chmod=0555 write-policy.py /app/write-policy.py
ARG REVISION=dev
LABEL org.opencontainers.image.title="Starhold Peridot relay" \
      org.opencontainers.image.source="https://github.com/Quadstronaut/Starhold/tree/master/apps/peridot-relay" \
      org.opencontainers.image.revision="$REVISION"
ENV PYTHONDONTWRITEBYTECODE=1
# Not root inside the container either (and rootless podman maps this uid to an unprivileged host subuid).
USER 10044:10044
EXPOSE 7777
WORKDIR /var/lib/strfry
ENTRYPOINT ["/app/strfry"]
CMD ["relay"]
