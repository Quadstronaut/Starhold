# PERI-14 Starhold Peridot relay (strfry, rootless user peridot-relay, container on 127.0.0.1:8770).
# NO ACCESS LOG FOR THIS HOST, ON PURPOSE: no `import tally` and no `log` directive, and the global options block
# keeps access lines out of the default log (`exclude http.log.access`). The client's address is never passed on:
# the X-Forwarded-*/Forwarded/X-Real-IP headers Caddy would add are removed, and strfry's realIpHeader is empty, so
# strfry only ever sees the server's own address (rootless port forwarding), never a client's. No `encode` (websockets) and no body cap on the upgrade itself:
# strfry caps every websocket message (maxWebsocketPayloadSize) and every event (maxEventSize).
# Error log: with no log directive this host is in Caddy's skip_hosts, and handle_errors (defence in depth) would put a
# handled error at DEBUG, below the default level. Tested with Caddy 2.11.4 (PERI-14): a failed upgrade to a dead relay
# (502) and a plain 502 wrote no log line at all, so no client address reaches the journal.
# Kept identical to the relay.starhold.app block in deploy/Caddyfile.dedicated (scripts/tests checks it).
relay.starhold.app {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Plain HTTP requests (the NIP-11 information document is a GET) never need a body.
	@not_upgrade not header Connection *pgrade*
	request_body @not_upgrade {
		max_size 1KB
	}
	reverse_proxy 127.0.0.1:8770 {
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -Cookie
		header_up -Authorization
		header_up -Referer
		header_up -User-Agent
	}
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
