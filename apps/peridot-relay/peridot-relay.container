# Starhold Peridot relay (PERI-14): strfry, rootless podman under its own unprivileged service user `peridot-relay`
# (no sudo, locked password, lingering). Installed into ~peridot-relay/.config/containers/systemd/ by the deploy
# script. Caddy (host network) is the only client: it terminates TLS for relay.starhold.app and proxies here.
[Unit]
Description=Starhold Peridot relay (strfry, loopback :8770)

[Container]
Image=localhost/peridot-relay:latest
ContainerName=peridot-relay
# Loopback only: nothing but the local Caddy can reach it. No privileged port.
PublishPort=127.0.0.1:8770:7777
# All relay data: one named volume (strfry's LMDB files). Nothing else is written.
Volume=peridot-relay-data:/var/lib/strfry
# Non-root inside the container too (the image's strfry user).
User=10044:10044
ReadOnly=true
Tmpfs=/tmp:rw,size=8m,mode=1777
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=64
# Open files: also the relay's overall connection cap (about 4,000 at once; each connection is one file).
Ulimit=nofile=4096:4096
PodmanArgs=--memory=768m --cpus=2

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
